# Web build settings (Vite). Copy to web/src/.env (vite.config.ts sets root: 'src', so Vite reads env files
# from web/src/), or set them in the build environment. Values are baked into the bundle at build time.

# Backend API base URL
VITE_API_URL=http://localhost:3000/api

# AI agent service base URL
VITE_AGENT_API_URL=http://localhost:3002/api/agent

# F-05: address for "Contact us for enterprise pricing" on the Pricing page
VITE_SUPPORT_EMAIL=sales@deltaprimeaisolutions.com
