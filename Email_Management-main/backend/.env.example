# Database (PostgreSQL)
DATABASE_URL=postgresql://Hello@localhost:5432/email_campaigns

# SMTP (fallback if no DB settings): Gmail, Hostinger, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# Open tracking: must be a PUBLIC URL (e.g. https://your-api.com or ngrok). If not set or localhost, opens won't be recorded when recipients open emails.
TRACKING_BASE_URL=http://localhost:3000

# Optional: base URL for List-Unsubscribe link (reduces spam folder placement). If set, emails include a one-click unsubscribe link.
# UNSUBSCRIBE_BASE_URL=https://your-api.com
# Unsubscribe links are signed with this secret (falls back to JWT_SECRET). Keep it stable: changing it breaks links in sent emails.
# UNSUBSCRIBE_SECRET=
# Set to off to refuse old unsubscribe links that only have ?email= (emails sent before signed links).
# UNSUBSCRIBE_LEGACY_LINKS=off

# Optional CRM AI reply labeling (only used when a user turns on AI labeling in CRM settings).
# Any OpenAI-compatible chat completions API works. If unset or failing, keyword labels are used.
# AI_LABELING_API_KEY=
# AI_LABELING_MODEL=gpt-4o-mini
# AI_LABELING_BASE_URL=https://api.openai.com/v1

# Login sessions (N-07 / N-17). Access tokens are short-lived; the session continues through an HttpOnly refresh cookie.
# Leave JWT_EXPIRES_IN unset (default 15m). Do NOT set it to 7d any more. JWT_SECRET is shared with the AI agent service.
# JWT_EXPIRES_IN=15m
# Exact web app origin(s) allowed to call the API with cookies (comma-separated, no wildcard). Required in production
# when the web app is not served from the API's own host. Requests from the API's own host are always allowed.
# CORS_ORIGIN=https://email.deltaprimeaisolutions.com
# Session cookies are Secure (HTTPS only; http://localhost also works in Chrome/Edge/Firefox). false = local http only.
# COOKIE_SECURE=false
# Lead Engine (lead finder). Off by default: the API answers 404 and `npm run worker:leadgen` idles.
#   off | admin (admins only, release step) | on (admins + plans with lead_gen_enabled)
# LEADGEN_ENABLED=off
# Sent with every request (identify the bot; Nominatim usage policy). Contact email for Nominatim.
# LEADGEN_USER_AGENT=MailFlowLeadBot/1.0 (+https://your-domain.com)
# LEADGEN_CONTACT_EMAIL=ops@your-domain.com
# Paid search results (DuckDuckGo blocks bots at volume). serpapi: the API key; dataforseo: "login:password".
# LEADGEN_SERP_PROVIDER=serpapi
# LEADGEN_SERP_API_KEY=
# LEADGEN_WORKER_CONCURRENCY=4
# LEADGEN_NOMINATIM_URL=https://nominatim.openstreetmap.org
# LEADGEN_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional licensed provider (People Data Labs), hot leads only; also enable the "pdl" source in the admin monitor.
# LEADGEN_PDL_API_KEY=
# Companies refreshed per night (01:00-05:00 server time).
# LEADGEN_REFRESH_BATCH=500
# Base URL of the privacy (opt-out) confirmation link; falls back to TRACKING_BASE_URL.
# PUBLIC_API_URL=https://your-api.com
